{
  "name": "devtool",
  "version": "0.6.0",
  "description": "Development workspace manager",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "predev": "node scripts/patch-dev-electron-plist.mjs",
    "dev": "electron-vite dev",
    "predev:cdp": "node scripts/patch-dev-electron-plist.mjs",
    "dev:cdp": "DEVTOOL_CDP_PORT=9222 electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:mac": "npm run build && electron-builder --mac --dir",
    "build:linux": "npm run build && electron-builder --linux --dir",
    "build:win": "npm run build && electron-builder --win --dir",
    "build:win:setup": "npm run build && electron-builder --win nsis zip --publish never",
    "release:win": "node scripts/release-win.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:notebook-live": "vitest run tests/notebook-kernel.live.test.ts",
    "postinstall": "node scripts/ensure-electron.mjs && npx @electron/rebuild -m . && node scripts/patch-dev-electron-plist.mjs",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "make-icon": "node scripts/make-icon.mjs"
  },
  "build": {
    "appId": "com.devtool.app",
    "productName": "DevTool",
    "copyright": "Copyright (c) join3r and TeleporterGuy. MIT License.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png",
      "node_modules/**/*",
      "!node_modules/.cache",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "asarUnpack": [
      "out/main/pi-status-extension.mjs",
      "out/main/notebook-kernel.py",
      "node_modules/node-pty/**"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "DevTool forwards microphone access to terminal apps you run inside it, such as Claude Code's voice mode.",
        "NSCameraUsageDescription": "DevTool forwards camera access to terminal apps you run inside it that request video input."
      },
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "dir",
      "category": "Development",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "dir",
      "icon": "build/icon.png",
      "signAndEditExecutable": false,
      "signtoolOptions": {
        "sign": "scripts/sign-win.cjs"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "DevTool",
      "deleteAppDataOnUninstall": false,
      "artifactName": "DevTool-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "join3r",
      "repo": "claude-project"
    },
    "electronDist": "node_modules/electron/dist",
    "afterPack": "scripts/win-rcedit.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^25.3.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "electron": "^43.6.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.280",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.3.3",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.14.0",
    "marked": "^17.0.5",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "uuid": "^13.0.0"
  },
  "allowScripts": {
    "electron@43.6.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.3": true,
    "node-pty@1.1.0": true
  },
  "overrides": {
    "node-abi": "4.35.0"
  }
}
