{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devtool.awantech.sk/schema/mobile/v2/app-message.schema.json",
  "title": "App message",
  "description": "One UTF-8 JSON message inside a Noise transport frame, SPEC.md §4.4. Receivers ignore unknown fields and ignore messages with an unknown t (or evt with an unknown e); a req with an unknown op is answered with ok:false, code unsupported.",
  "oneOf": [
    { "$ref": "#/$defs/req" },
    { "$ref": "#/$defs/resOk" },
    { "$ref": "#/$defs/resErr" },
    { "$ref": "#/$defs/inboxEvt" },
    { "$ref": "#/$defs/pairingEvt" },
    { "$ref": "chat.schema.json#/$defs/chatEvt" }
  ],
  "$defs": {
    "id": { "type": "integer", "minimum": 0 },
    "req": {
      "type": "object",
      "required": ["t", "id", "op"],
      "properties": {
        "t": { "const": "req" },
        "id": { "$ref": "#/$defs/id" },
        "op": { "type": "string", "description": "inbox.get, a chat.* op (SPEC.md §6.3), or a §7.4/§8 op such as task.new or stream.new" },
        "params": { "description": "Op-specific (SPEC.md §6.3, §8); the chat ops take an object with tabId, stream.new #/$defs/streamNewParams, branches.list #/$defs/branchesListParams." }
      }
    },
    "resOk": {
      "type": "object",
      "required": ["t", "id", "ok", "result"],
      "properties": {
        "t": { "const": "res" },
        "id": { "$ref": "#/$defs/id" },
        "ok": { "const": true },
        "result": { "description": "Op-specific; an Inbox for inbox.get, chat.schema.json for the chat ops, #/$defs/streamNewResult and #/$defs/branchesListResult for stream.new and branches.list." }
      }
    },
    "resErr": {
      "type": "object",
      "required": ["t", "id", "ok", "error"],
      "properties": {
        "t": { "const": "res" },
        "id": { "$ref": "#/$defs/id" },
        "ok": { "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "description": "unsupported, bad-request, not-authorized, internal, not-found, gone, or newer codes" },
            "message": { "type": "string" }
          }
        }
      }
    },
    "inboxEvt": {
      "type": "object",
      "required": ["t", "e", "seq", "inbox"],
      "properties": {
        "t": { "const": "evt" },
        "e": { "const": "inbox" },
        "seq": { "type": "integer", "minimum": 0 },
        "inbox": { "$ref": "inbox.schema.json" }
      }
    },
    "streamNewParams": {
      "description": "stream.new params (SPEC.md §8.12). branch and baseBranch only count with worktree: true.",
      "type": "object",
      "required": ["projectId", "name", "worktree"],
      "properties": {
        "projectId": { "type": "string" },
        "name": { "type": "string", "pattern": "\\S" },
        "worktree": { "type": "boolean" },
        "branch": { "type": "string", "pattern": "\\S" },
        "baseBranch": { "type": "string", "pattern": "\\S" }
      }
    },
    "streamNewResult": {
      "description": "stream.new result (SPEC.md §8.12).",
      "type": "object",
      "required": ["streamId"],
      "properties": { "streamId": { "type": "string" } }
    },
    "branchesListParams": {
      "description": "branches.list params (SPEC.md §8.13).",
      "type": "object",
      "required": ["projectId"],
      "properties": { "projectId": { "type": "string" } }
    },
    "branchesListResult": {
      "description": "branches.list result (SPEC.md §8.13): local branches, and the one the desktop's dialog picks first (\"\" when there is none).",
      "type": "object",
      "required": ["branches", "defaultBase"],
      "properties": {
        "branches": { "type": "array", "items": { "type": "string" } },
        "defaultBase": { "type": "string" }
      }
    },
    "pairingEvt": {
      "type": "object",
      "required": ["t", "e", "status"],
      "properties": {
        "t": { "const": "evt" },
        "e": { "const": "pairing" },
        "status": { "enum": ["accepted", "rejected", "revoked"] }
      }
    }
  }
}
