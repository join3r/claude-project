{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devtool.awantech.sk/schema/mobile/v2/chat.schema.json",
  "title": "Chat view",
  "description": "The chat view model, SPEC.md §6.2, and the chat.* results, §6.3 and §8. Describes what a desktop sends; receivers keep unknown item and prompt kinds as 'Needs a newer app' and ignore unknown fields.",
  "$ref": "#/$defs/view",
  "$defs": {
    "ms": { "type": "integer", "minimum": 0 },
    "process": { "enum": ["idle", "starting", "running", "exited"] },
    "settings": {
      "description": "The composer's model and effort pickers. Absent model/effort = Claude's settings default.",
      "type": "object",
      "required": ["models", "efforts"],
      "properties": {
        "model": { "type": "string", "description": "The picked models[].value" },
        "modelName": { "type": "string" },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": { "value": { "type": "string" }, "label": { "type": "string" }, "description": { "type": "string" } }
          }
        },
        "effort": { "type": "string" },
        "defaultEffort": { "type": "string" },
        "efforts": { "type": "array", "items": { "type": "string" } },
        "effortLabel": { "type": "string", "description": "The effort picker's name when not \"Effort\" (Pi: \"Thinking\")" },
        "modes": {
          "description": "The agent's mode picker (Codex's presets); [] = no modes (Pi); absent = the task.new modes",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": { "value": { "type": "string" }, "label": { "type": "string" }, "description": { "type": "string" } }
          }
        }
      }
    },
    "limit": {
      "type": "object",
      "required": ["used"],
      "properties": { "used": { "type": "integer", "minimum": 0, "description": "Percent used, 0–100" }, "resetsAt": { "$ref": "#/$defs/ms" } }
    },
    "usage": {
      "type": "object",
      "properties": {
        "contextTokens": { "type": "integer", "minimum": 0 },
        "contextMax": { "type": "integer", "minimum": 0 },
        "costCents": { "type": "integer", "minimum": 0 },
        "fiveHour": { "$ref": "#/$defs/limit" },
        "sevenDay": { "$ref": "#/$defs/limit" }
      }
    },
    "task": {
      "type": "object",
      "required": ["id", "kind", "description", "status"],
      "description": "§8.20: one row of the task pill",
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string", "description": "subagent | shell | workflow | monitor | mcp | other; unknown reads as other" },
        "description": { "type": "string", "description": "≤ 300 chars" },
        "status": { "type": "string", "description": "running | completed | failed | stopped; unknown reads as running" },
        "startedAt": { "$ref": "#/$defs/ms" },
        "endedAt": { "$ref": "#/$defs/ms" },
        "background": { "const": true },
        "command": { "type": "string", "description": "≤ 300 chars" },
        "agentType": { "type": "string" },
        "detail": { "type": "string", "description": "≤ 300 chars" },
        "toolUses": { "type": "integer", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 },
        "workflow": { "$ref": "#/$defs/workflow" }
      }
    },
    "workflow": {
      "type": "object",
      "required": ["phases", "agents"],
      "properties": {
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title"],
            "properties": { "title": { "type": "string" }, "detail": { "type": "string" }, "started": { "const": true } }
          }
        },
        "agents": {
          "type": "array",
          "description": "≤ 100",
          "items": {
            "type": "object",
            "required": ["label", "state"],
            "properties": {
              "label": { "type": "string", "description": "≤ 300 chars" },
              "phase": { "type": "integer", "minimum": 0, "description": "Index into phases" },
              "state": { "type": "string", "description": "queued | running | done | failed | skipped; unknown reads as running" },
              "startedAt": { "$ref": "#/$defs/ms" },
              "durationMs": { "type": "integer", "minimum": 0 },
              "tokens": { "type": "integer", "minimum": 0 },
              "lastTool": { "type": "string", "description": "≤ 300 chars" },
              "attempt": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "moreAgents": { "type": "integer", "minimum": 1 }
      }
    },
    "view": {
      "type": "object",
      "required": ["tabId", "title", "busy", "process", "items", "hasEarlier", "prompts"],
      "properties": {
        "tabId": { "type": "string" },
        "agent": { "type": "string", "description": "codex | pi; absent = Claude" },
        "title": { "type": "string" },
        "busy": { "type": "boolean" },
        "turnStartedAt": { "$ref": "#/$defs/ms" },
        "process": { "$ref": "#/$defs/process" },
        "processError": { "type": "string" },
        "permissionMode": { "type": "string" },
        "model": { "type": "string" },
        "settings": { "$ref": "#/$defs/settings" },
        "usage": { "$ref": "#/$defs/usage" },
        "tasks": { "type": "array", "description": "≤ 20", "items": { "$ref": "#/$defs/task" } },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "hasEarlier": { "type": "boolean" },
        "prompts": { "type": "array", "items": { "$ref": "#/$defs/prompt" } }
      }
    },
    "item": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "id", "text"],
          "properties": {
            "kind": { "const": "user" }, "id": { "type": "string" }, "text": { "type": "string", "description": "≤ 16000 chars" },
            "images": { "type": "integer", "minimum": 1 }, "queued": { "const": true }, "failed": { "const": true }
          }
        },
        {
          "type": "object",
          "required": ["kind", "id", "markdown"],
          "properties": { "kind": { "const": "text" }, "id": { "type": "string" }, "markdown": { "type": "string", "description": "≤ 16000 chars" }, "streaming": { "const": true } }
        },
        {
          "type": "object",
          "required": ["kind", "id", "preview"],
          "properties": { "kind": { "const": "thinking" }, "id": { "type": "string" }, "preview": { "type": "string", "description": "≤ 300 chars" }, "streaming": { "const": true } }
        },
        {
          "type": "object",
          "required": ["kind", "id", "name", "summary", "status", "hasDetail"],
          "properties": {
            "kind": { "const": "tool" }, "id": { "type": "string" }, "name": { "type": "string" }, "summary": { "type": "string" },
            "status": { "enum": ["pending", "running", "waiting", "done", "error", "denied"] },
            "hasDetail": { "type": "boolean" }, "childCount": { "type": "integer", "minimum": 0 }, "lastChild": { "type": "string" },
            "images": { "type": "integer", "minimum": 1, "description": "Images the result carried, at most 4; fetched with chat.image (§8.9)" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "id", "text", "tone"],
          "properties": { "kind": { "const": "notice" }, "id": { "type": "string" }, "text": { "type": "string" }, "tone": { "enum": ["muted", "warning", "error"] } }
        }
      ]
    },
    "prompt": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "id", "toolName", "title", "summary", "canAlwaysAllow"],
          "properties": {
            "kind": { "const": "permission" }, "id": { "type": "string" }, "toolName": { "type": "string" }, "title": { "type": "string" },
            "summary": { "type": "string" }, "detail": { "type": "string", "description": "≤ 4000 chars" },
            "canAlwaysAllow": { "type": "boolean" }, "agent": { "const": true }
          }
        },
        {
          "type": "object",
          "required": ["kind", "id", "questions"],
          "properties": {
            "kind": { "const": "question" }, "id": { "type": "string" },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["question", "multiSelect", "options"],
                "properties": {
                  "question": { "type": "string" }, "header": { "type": "string" }, "multiSelect": { "type": "boolean" },
                  "options": {
                    "type": "array",
                    "items": { "type": "object", "required": ["label"], "properties": { "label": { "type": "string" }, "description": { "type": "string" } } }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "id", "markdown"],
          "properties": { "kind": { "const": "plan" }, "id": { "type": "string" }, "markdown": { "type": "string" } }
        }
      ]
    },
    "openResult": {
      "type": "object",
      "required": ["seq", "view"],
      "properties": { "seq": { "type": "integer", "minimum": 0 }, "view": { "$ref": "#/$defs/view" } }
    },
    "earlierResult": {
      "type": "object",
      "required": ["items", "hasEarlier"],
      "properties": { "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }, "hasEarlier": { "type": "boolean" } }
    },
    "detailResult": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "input"],
          "properties": { "kind": { "const": "tool" }, "input": { "type": "string" }, "result": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["kind", "markdown"],
          "properties": { "kind": { "const": "text" }, "markdown": { "type": "string" } }
        }
      ]
    },
    "imageResult": {
      "description": "chat.image (§8.9): one tool-result image, base64 without a data: prefix, at most 3000000 chars.",
      "type": "object",
      "required": ["mediaType", "data"],
      "properties": {
        "mediaType": { "enum": ["image/png", "image/jpeg", "image/gif", "image/webp"] },
        "data": { "type": "string", "pattern": "^[A-Za-z0-9+/]+=*$" }
      }
    },
    "commandsResult": {
      "description": "chat.commands (§8.14): the composer's / menu, in the desktop's order. May be empty before Claude has reported its commands.",
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "description": "Without the leading /" },
              "description": { "type": "string" },
              "argumentHint": { "type": "string" },
              "terminalOnly": { "const": true }
            }
          }
        }
      }
    },
    "btwResult": {
      "description": "chat.btw (§8.14): the side question's answer; null when Claude had nothing to say. synthetic: the CLI made it up (an error or refusal).",
      "type": "object",
      "required": ["response"],
      "properties": {
        "response": { "oneOf": [{ "type": "string" }, { "const": null }] },
        "synthetic": { "const": true }
      }
    },
    "permissionKind": { "enum": ["localSettings", "projectSettings", "userSettings"] },
    "rules": { "type": "array", "items": { "type": "string" } },
    "permissionsResult": {
      "description": "chat.permissions and chat.permissions.update (§8.14): the settings files Claude reads rules from, most specific first.",
      "type": "object",
      "required": ["sources"],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "path", "exists", "allow", "ask", "deny"],
            "properties": {
              "kind": { "$ref": "#/$defs/permissionKind" },
              "path": { "type": "string", "description": "Absolute, on the desktop" },
              "exists": { "type": "boolean" },
              "allow": { "$ref": "#/$defs/rules" },
              "ask": { "$ref": "#/$defs/rules" },
              "deny": { "$ref": "#/$defs/rules" },
              "error": { "type": "string", "description": "The file exists but couldn't be read; it isn't edited" }
            }
          }
        }
      }
    },
    "permissionsUpdateParams": {
      "description": "chat.permissions.update params (§8.14).",
      "type": "object",
      "required": ["tabId", "kind", "behavior", "rule", "action"],
      "properties": {
        "tabId": { "type": "string" },
        "kind": { "$ref": "#/$defs/permissionKind" },
        "behavior": { "enum": ["allow", "ask", "deny"] },
        "rule": { "type": "string", "pattern": "\\S", "maxLength": 2000 },
        "action": { "enum": ["add", "remove"] }
      }
    },
    "chatEvt": {
      "type": "object",
      "required": ["t", "e", "tabId", "seq", "upserts", "removes", "prompts", "busy", "process"],
      "properties": {
        "t": { "const": "evt" },
        "e": { "const": "chat" },
        "tabId": { "type": "string" },
        "seq": { "type": "integer", "minimum": 0 },
        "upserts": { "type": "array", "items": { "$ref": "#/$defs/item" } },
        "removes": { "type": "array", "items": { "type": "string" } },
        "prompts": { "type": "array", "items": { "$ref": "#/$defs/prompt" } },
        "busy": { "type": "boolean" },
        "turnStartedAt": { "$ref": "#/$defs/ms" },
        "process": { "$ref": "#/$defs/process" },
        "processError": { "type": "string" },
        "permissionMode": { "type": "string" },
        "model": { "type": "string" },
        "settings": { "$ref": "#/$defs/settings" },
        "usage": { "$ref": "#/$defs/usage" },
        "tasks": { "type": "array", "description": "≤ 20", "items": { "$ref": "#/$defs/task" } }
      }
    }
  }
}
