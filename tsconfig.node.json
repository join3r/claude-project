{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "outDir": "out",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "composite": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/server/**/*", "src/shared/**/*", "protocol/ts/**/*"],
  "exclude": ["protocol/ts/**/*.test.ts"]
}
